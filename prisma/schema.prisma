generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  // pooled connection은 일반 쿼리에, direct는 마이그레이션에 사용 (Neon + PgBouncer 호환)
}

// ═══════════════════════════════════════════════════════════
// NextAuth.js Auth.js v5 표준 모델
// 카카오/구글 양쪽 OAuth를 지원하기 위해 Account 테이블 분리.
// ═══════════════════════════════════════════════════════════

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // 데이트립 고유 필드
  nickname      String?   @unique
  bio           String?
  preferences   String[]  @default([])

  // 관계
  accounts        Account[]
  sessions        Session[]
  trips           Trip[]
  likes           Like[]
  recommendation  Recommendation?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String  // "kakao" | "google"
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

// ═══════════════════════════════════════════════════════════
// 데이트립 도메인 모델
// ═══════════════════════════════════════════════════════════

model Trip {
  id          String   @id @default(cuid())
  title       String
  slug        String?  @unique
  description String?
  coverImage  String?

  region      String?
  tags        String[]
  isPublic    Boolean  @default(true)

  // 역정규화: 매번 COUNT 쿼리 대신 컬럼으로 캐시. Like 변경 시 트랜잭션으로 동기화.
  viewCount   Int      @default(0)
  likeCount   Int      @default(0)

  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  places      Place[]
  likes       Like[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([authorId])
  @@index([createdAt])
}

model Place {
  id           String   @id @default(cuid())

  // 카카오맵 원본 정보 (폐업/개명 시에도 코스 기록 보존)
  kakaoPlaceId String?
  name         String
  category     String?
  address      String
  roadAddress  String?
  latitude     Float
  longitude    Float
  phone        String?

  // 사용자가 추가한 정보 ─ 데이트립의 차별 가치
  order        Int      // 코스 내 순서
  memo         String?
  // Vercel Blob URL. null이면 12-B에서 폴백 카드(그라데이션+장소명) 렌더.
  // 장소당 1장 정책 (캐러셀 슬라이드 = 장소 1:1).
  imageUrl     String?

  tripId       String
  trip         Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())

  @@index([tripId, order])
}

model Like {
  userId    String
  tripId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@id([userId, tripId])
}

// AI 추천 결과 캐시. 사용자당 1행.
// generatedAt + 24h 지나면 다음 접속 시 재계산 (lib/recommend.ts 참조 예정)
// 캐시 미스 또는 AI 실패 시 폴백 로직이 별도로 동작하므로 이 테이블 비어있어도 추천 섹션은 표시됨
model Recommendation {
  userId      String   @id
  tripIds     String[] // 추천된 코스 ID 배열 (순서 = 추천 순위)
  reasons     Json     // {[tripId]: "이유 문장"} 형태
  generatedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([generatedAt]) // 오래된 캐시 일괄 정리용
}

// 사용자 문의. /contact 페이지에서 제출됨.
model Inquiry {
  id        String   @id @default(cuid())
  email     String
  name      String?
  category  String   // "general" | "bug" | "report" | "other"
  message   String   @db.Text
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([resolved, createdAt])
}
